<div class="card shadow border-0 mt-3">
  <div class="card-header card-header-light">
    <h2 class="card-title h5"><%= t(".title") %></h2>
  </div>

  <div class="card-body">
    <% binding = feed.apple_show_feed_binding %>
    <% hls_config = feed.apple_hls_config %>

    <% if feed.errors[:apple_connection].any? %>
      <div class="alert alert-danger" role="alert"><%= feed.errors[:apple_connection].to_sentence %></div>
    <% end %>

    <% if feed.errors[:apple_hls_enabled].any? %>
      <div class="alert alert-danger" role="alert"><%= feed.errors[:apple_hls_enabled].to_sentence %></div>
    <% end %>

    <%= turbo_frame_tag dom_id(feed, :apple_connection),
          src: podcast_feed_apple_connection_path(podcast, feed, selection: feed.apple_connection.to_s), loading: "lazy" do %>
      <%= render "apple_connection_field", feed: feed, form: form, options: [], loading: true, lookup_failed: false %>
    <% end %>

    <div class="form-floating input-group mb-3">
      <%= form.text_field :apple_verify_token %>
      <%= form.label :apple_verify_token %>
      <%= field_help_text t("feeds.form_main.help.apple_verify_token") %>
    </div>

    <div class="form-check mb-2">
      <%= form.check_box :apple_hls_enabled, disabled: !policy(feed).update? %>
      <div class="d-flex align-items-center">
        <%= form.label :apple_hls_enabled %>
        <%= help_text t(".help.hls_enabled") %>
      </div>
    </div>

    <% if hls_config&.not_eligible? %>
      <div class="alert alert-warning mb-0" role="status"><%= t(".hls_not_eligible") %></div>
    <% end %>
  </div>

  <div class="card-footer d-flex justify-content-between align-items-end">
    <div>
      <strong><%= t(".status") %></strong><br>
      <% if binding %>
        <span class="text-muted"><%= t(".last_checked_html", time: local_time_ago(binding.updated_at)) %></span>
      <% end %>
      <% if hls_config&.enabled? && hls_config.last_checked_at %>
        <br><span class="text-muted"><%= t(".hls_last_checked_html", time: local_time_ago(hls_config.last_checked_at)) %></span>
      <% end %>
    </div>
    <span class="badge <%= binding ? "bg-success" : "bg-secondary" %>">
      <%= binding ? t(".connected") : t(".not_connected") %>
    </span>
  </div>
</div>
