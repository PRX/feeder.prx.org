<% mapping = settings.mapping %>
<% options = apple_delivery_options(settings) %>
<% delivery_data = {apple_settings_target: "deliverySelect", action: "apple-settings#sync"} %>
<% if settings.confirm_leaving_own_show? %>
  <% delivery_data.merge!(confirm_field_target: "field", confirm_with: t("feeds.form_apple_settings.confirm_leave_own_show")) %>
<% end %>

<% if settings.mapping_bindings.empty? && !settings.delivering? %>
  <% no_mappings = (feed.persisted? && settings.binding&.persisted?) ? "no_mappings_own_show" : "no_mappings" %>
  <div class="alert alert-info" role="status"><%= t("feeds.form_apple_settings.#{no_mappings}") %></div>
<% end %>

<div class="form-floating input-group mb-3">
  <%= apple.select :delivery, options, {}, data: delivery_data %>
  <%= apple.label :delivery %>
  <%= field_help_text t("feeds.form_apple_settings.help.delivery") %>
</div>

<div class="form-floating input-group mb-3 <%= "d-none" unless mapping %>" data-apple-settings-target="mappedShowGroup">
  <%= apple.text_field :mapped_show_id, disabled: true, id: nil, data: {apple_settings_target: "mappedShowField"} %>
  <%= apple.label :mapped_show_id %>
  <%= link_to (mapping ? podcast_feed_path(feed.podcast, mapping.feed) : "#"),
        class: "input-group-text prx-input-group-text", title: t("feeds.form_apple_settings.view_mapped_feed"),
        data: {apple_settings_target: "mappedLink", turbo_frame: "_top"} do %>
    <span class="material-icons text-primary">arrow_forward</span>
  <% end %>
</div>

<div class="<%= "d-none" unless settings.delivering? %>" data-apple-settings-target="deliverySettings">
  <div class="form-check mb-2">
    <%= apple.check_box :publish_enabled %>
    <div class="d-flex align-items-center">
      <%= apple.label :publish_enabled %>
      <%= help_text t("feeds.form_apple_settings.help.publish_enabled") %>
    </div>
  </div>

  <div class="form-check mb-2">
    <%= apple.check_box :sync_blocks_rss %>
    <div class="d-flex align-items-center">
      <%= apple.label :sync_blocks_rss %>
      <%= help_text t("feeds.form_apple_settings.help.sync_blocks_rss") %>
    </div>
  </div>
</div>
