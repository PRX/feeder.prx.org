<%= turbo_frame_tag dom_id(@feed, :apple_connection) do %>
  <%= fields_for "feed[apple_settings]", @apple_settings do |apple| %>
    <%= render "feeds/apple_connection_field", feed: @feed, settings: @apple_settings, apple: apple,
          options: @apple_connection_options, loading: false, lookup_failed: @apple_show_lookup_failed %>
  <% end %>
<% end %>
