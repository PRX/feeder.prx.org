<%= turbo_frame_tag turbo_frame_request_id || "location-search" do %>
  <%= render "location_searches/busy" %>

  <div class="prx-hide-busy">
    <% if @error %>
      <div class="alert alert-warning mb-0" role="alert"><%= t(".#{@error}") %></div>
    <% elsif @places.nil? %>
      <p class="text-muted mb-0"><%= t(".too_short") %></p>
    <% elsif @places.empty? %>
      <p class="text-muted mb-0"><%= t(".empty") %></p>
    <% else %>
      <div class="list-group">
        <% @places.each do |place| %>
          <%= tag.button type: "button",
                class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                data: {
                  action: "location#select",
                  location_name_param: place.name,
                  location_latitude_param: place.latitude,
                  location_longitude_param: place.longitude,
                  location_osm_param: place.osm,
                  location_country_param: place.country
                } do %>
            <span><%= place.display_name %></span>
            <% if place.country.present? %>
              <span class="badge text-bg-secondary ms-2"><%= place.country %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <p class="form-text mb-0 mt-2">
      <%= t(".attribution_html", link: link_to("OpenStreetMap", Location.osm_url("copyright"), target: "_blank", rel: "noopener")) %>
    </p>
  </div>
<% end %>
